    "event_count": {"type": "integer", "minimum": 0},
    "session_count": {"type": "integer", "minimum": 0},
    "event_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "classification_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "boundary_violation_count": {"type": "integer", "minimum": 0},
    "boundary_violation_required_value": {"const": 0},
    "unknown_count": {"type": "integer", "minimum": 0},
    "metric_definitions": {"type": "array", "items": {"type": "object"}},
