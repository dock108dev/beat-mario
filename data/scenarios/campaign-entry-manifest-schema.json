{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-companion-campaign-entry-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "source_tree",
    "repository_clean",
    "created_at",
    "classification_hash",
    "contract_hashes",
    "deterministic_evidence",
    "owner_fields_blank",
    "owner_fields_source",
    "campaign_completion",
    "proof_limits"
  ],
  "properties": {
    "schema_version": {"const": "game-companion-campaign-entry-manifest/v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_clean": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "classification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "deterministic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focused_readiness", "focused_v2", "canonical_non_live"],
      "properties": {
        "focused_readiness": {"$ref": "#/$defs/gate"},
        "focused_v2": {"$ref": "#/$defs/gate"},
        "canonical_non_live": {"$ref": "#/$defs/gate"}
      }
    },
    "owner_fields_blank": {"const": true},
    "owner_fields_source": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string"}
    },
    "campaign_completion": {"const": "pending"},
    "proof_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "test_total"],
      "properties": {
        "status": {"const": "passed"},
        "test_total": {"type": "integer", "minimum": 1}
      }
    }
  }
}
